--// สถานะ
local fpsEnabled = false
local textureEnabled = false

--// เก็บค่า Texture/Decal เดิม
local originalTransparency = {}

--// FPS BOOST
local function boostFPS(state)
    fpsEnabled = state

    Lighting.GlobalShadows = not state

    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") then
            v.Enabled = not state
        end
    end

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CastShadow = not state

        elseif v:IsA("ParticleEmitter")
        or v:IsA("Trail")
        or v:IsA("Beam") then
            v.Enabled = not state
        end
    end

    fpsButton.Text = state and "FPS Boost : ON" or "FPS Boost : OFF"
end

--// ลบ/คืนพื้นผิว
local function toggleTextures(state)
    textureEnabled = state

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Texture") or v:IsA("Decal") then

            if state then
                if originalTransparency[v] == nil then
                    originalTransparency[v] = v.Transparency
                end

                v.Transparency = 1
            else
                if originalTransparency[v] ~= nil then
                    v.Transparency = originalTransparency[v]
                end
            end
        end
    end

    textureButton.Text =
        state and "Textures : REMOVED"
        or "Textures : OFF"
end

--// ปุ่ม FPS
fpsButton.MouseButton1Click:Connect(function()
    boostFPS(not fpsEnabled)
end)

--// ปุ่ม Texture
textureButton.MouseButton1Click:Connect(function()
    toggleTextures(not textureEnabled)
end)

